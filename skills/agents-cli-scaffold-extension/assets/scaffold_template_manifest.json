{
  "manifest_version": "1.0.0",
  "variables": ["name", "agent_name", "model", "web_port", "adk_port"],
  "syntax": "Literal @@variable@@ tokens; no expression evaluation or shell substitution.",
  "files": [
    {"path": "package.json", "template": "templates/package.json.tmpl"},
    {"path": "apps/web/package.json", "template": "templates/web-package.json.tmpl"},
    {"path": "apps/web/tsconfig.json", "template": "templates/tsconfig.json.tmpl"},
    {"path": "apps/web/src/app.ts", "template": "templates/app.ts.tmpl"},
    {"path": "apps/web/src/index.ts", "template": "templates/index.ts.tmpl"},
    {"path": "apps/agents/requirements.txt", "template": "templates/requirements.txt.tmpl"},
    {"path": "apps/agents/@@agent_name@@/__init__.py", "content": "from . import agent\n"},
    {"path": "apps/agents/@@agent_name@@/agent.py", "template": "templates/agent.py.tmpl"},
    {"path": "contracts/message.schema.json", "template": "templates/message.schema.json.tmpl"},
    {"path": ".gitignore", "content": ".venv/\nnode_modules/\ndist/\n__pycache__/\n*.pyc\n.env\n.env.*\n*.db\n*.db-*\n.adk/\n"},
    {"path": "WORKSPACE.md", "template": "templates/WORKSPACE.md.tmpl"}
  ]
}
