{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ap2-protocol.org/schemas/payment_mandate.json",
  "title": "AP2 Payment Mandate Content",
  "description": "Mandate content for an AP2 Payment Mandate, open or closed, per AP2 v0.2 (https://ap2-protocol.org/ap2/payment_mandate/). This validates the decoded mandate content object, not the SD-JWT envelope. Amounts are integer minor units per ISO 4217: 19900 = $199.00.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/closedPaymentMandate" },
    { "$ref": "#/$defs/openPaymentMandate" }
  ],
  "$defs": {
    "closedPaymentMandate": {
      "title": "Closed Payment Mandate",
      "description": "Authorizes payment for one specific checkout. Verified by the Credential Provider, Network, and Merchant Payment Processor.",
      "type": "object",
      "properties": {
        "vct": { "const": "mandate.payment.1" },
        "transaction_id": {
          "$ref": "#/$defs/base64url",
          "description": "base64url hash of the checkout_jwt. MUST equal the Checkout Mandate checkout_hash. Never generate this independently."
        },
        "payee": { "$ref": "#/$defs/merchant" },
        "pisp": { "$ref": "#/$defs/pisp" },
        "payment_amount": { "$ref": "#/$defs/amount" },
        "payment_instrument": { "$ref": "#/$defs/paymentInstrument" },
        "execution_date": {
          "type": "string",
          "description": "ISO 8601 date of execution. Absent means immediate."
        },
        "risk_data": {
          "type": "object",
          "description": "Risk signals collected by the Trusted Surface at mandate creation."
        },
        "iat": { "$ref": "#/$defs/epochSeconds" },
        "exp": { "$ref": "#/$defs/epochSeconds" }
      },
      "required": [
        "vct",
        "transaction_id",
        "payee",
        "payment_amount",
        "payment_instrument"
      ],
      "additionalProperties": true
    },
    "openPaymentMandate": {
      "title": "Open Payment Mandate",
      "description": "Delegated spend authority under constraints. MAY include any property of the closed form.",
      "type": "object",
      "properties": {
        "vct": { "const": "mandate.payment.open.1" },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "description": "SHOULD bound both money (payment.amount_range) and counterparty (payment.allowed_payees or payment.reference). amount_range alone authorizes paying anyone up to the ceiling.",
          "items": { "$ref": "#/$defs/paymentConstraint" }
        },
        "cnf": {
          "$ref": "#/$defs/cnf",
          "description": "REQUIRED while the mandate is open."
        },
        "transaction_id": { "$ref": "#/$defs/base64url" },
        "payee": { "$ref": "#/$defs/merchant" },
        "pisp": { "$ref": "#/$defs/pisp" },
        "payment_amount": { "$ref": "#/$defs/amount" },
        "payment_instrument": { "$ref": "#/$defs/paymentInstrument" },
        "execution_date": { "type": "string" },
        "risk_data": { "type": "object" },
        "iat": { "$ref": "#/$defs/epochSeconds" },
        "exp": {
          "$ref": "#/$defs/epochSeconds",
          "description": "RECOMMENDED to be the smallest value that lets the agent finish the task."
        }
      },
      "required": ["vct", "constraints", "cnf"],
      "additionalProperties": true
    },
    "paymentConstraint": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "$ref": "#/$defs/amountRangeConstraint" },
        { "$ref": "#/$defs/allowedPayeesConstraint" },
        { "$ref": "#/$defs/allowedPaymentInstrumentsConstraint" },
        { "$ref": "#/$defs/allowedPispsConstraint" },
        { "$ref": "#/$defs/agentRecurrenceConstraint" },
        { "$ref": "#/$defs/budgetConstraint" },
        { "$ref": "#/$defs/referenceConstraint" },
        { "$ref": "#/$defs/executionDateConstraint" },
        {
          "description": "Extension point. A verifier that does not recognise the type MUST fail evaluation.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "not": {
                "enum": [
                  "payment.amount_range",
                  "payment.allowed_payees",
                  "payment.allowed_payment_instruments",
                  "payment.allowed_pisps",
                  "payment.agent_recurrence",
                  "payment.budget",
                  "payment.reference",
                  "payment.execution_date"
                ]
              }
            }
          },
          "required": ["type"]
        }
      ]
    },
    "amountRangeConstraint": {
      "title": "payment.amount_range",
      "type": "object",
      "properties": {
        "type": { "const": "payment.amount_range" },
        "currency": { "$ref": "#/$defs/currency" },
        "max": { "type": "integer", "minimum": 0, "description": "Minor units." },
        "min": { "type": "integer", "minimum": 0, "description": "Minor units. Absent means no minimum." }
      },
      "required": ["type", "currency", "max"],
      "additionalProperties": false
    },
    "allowedPayeesConstraint": {
      "title": "payment.allowed_payees",
      "type": "object",
      "properties": {
        "type": { "const": "payment.allowed_payees" },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "description": "Selectively disclosable.",
          "items": { "$ref": "#/$defs/merchant" }
        }
      },
      "required": ["type", "allowed"],
      "additionalProperties": false
    },
    "allowedPaymentInstrumentsConstraint": {
      "title": "payment.allowed_payment_instruments",
      "type": "object",
      "properties": {
        "type": { "const": "payment.allowed_payment_instruments" },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "description": "Selectively disclosable. Add the x402 instrument type here when moving to a crypto rail rather than dropping the constraint.",
          "items": { "$ref": "#/$defs/paymentInstrument" }
        }
      },
      "required": ["type", "allowed"],
      "additionalProperties": false
    },
    "allowedPispsConstraint": {
      "title": "payment.allowed_pisps",
      "type": "object",
      "properties": {
        "type": { "const": "payment.allowed_pisps" },
        "allowed": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pisp" } }
      },
      "required": ["type", "allowed"],
      "additionalProperties": false
    },
    "agentRecurrenceConstraint": {
      "title": "payment.agent_recurrence",
      "description": "Stateful: evaluation requires a persisted ledger of prior presentations.",
      "type": "object",
      "properties": {
        "type": { "const": "payment.agent_recurrence" },
        "frequency": {
          "enum": ["ON_DEMAND", "DAILY", "WEEKLY", "BIWEEKLY", "MONTHLY", "QUARTERLY", "ANNUALLY"]
        },
        "max_occurrences": { "type": "integer", "minimum": 1 }
      },
      "required": ["type", "frequency"],
      "additionalProperties": false
    },
    "budgetConstraint": {
      "title": "payment.budget",
      "description": "Stateful: requires tracking cumulative spend. Meaningful only alongside payment.agent_recurrence.",
      "type": "object",
      "properties": {
        "type": { "const": "payment.budget" },
        "max": { "type": "number", "minimum": 0 },
        "currency": { "$ref": "#/$defs/currency" }
      },
      "required": ["type", "max", "currency"],
      "additionalProperties": false
    },
    "referenceConstraint": {
      "title": "payment.reference",
      "type": "object",
      "properties": {
        "type": { "const": "payment.reference" },
        "conditional_transaction_id": {
          "$ref": "#/$defs/base64url",
          "description": "Digest of the associated open Checkout Mandate."
        }
      },
      "required": ["type", "conditional_transaction_id"],
      "additionalProperties": false
    },
    "executionDateConstraint": {
      "title": "payment.execution_date",
      "type": "object",
      "properties": {
        "type": { "const": "payment.execution_date" },
        "not_before": { "type": "string" },
        "not_after": { "type": "string" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "amount": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0,
          "description": "Integer minor units per ISO 4217: 19900 = $199.00. Passing major units is the most common AP2 bug. Note that JSON Schema treats 199.0 as an integer, so this constraint rejects 199.99 but cannot distinguish major from minor units on whole numbers - check the magnitude against the checkout total as well."
        },
        "currency": { "$ref": "#/$defs/currency" }
      },
      "required": ["amount", "currency"],
      "additionalProperties": false
    },
    "merchant": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "website": { "type": "string", "format": "uri" }
      },
      "required": ["id", "name"],
      "additionalProperties": true
    },
    "paymentInstrument": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "description": "Extension point: 'card', 'dpc', 'UPI', an x402-compatible type, etc."
        },
        "description": { "type": "string", "description": "Display-only, e.g. 'Card ....4242'." }
      },
      "required": ["id", "type"],
      "additionalProperties": true
    },
    "pisp": {
      "type": "object",
      "properties": {
        "legal_name": { "type": "string" },
        "brand_name": { "type": "string" },
        "domain_name": { "type": "string" }
      },
      "required": ["legal_name", "brand_name", "domain_name"],
      "additionalProperties": true
    },
    "cnf": {
      "type": "object",
      "properties": {
        "jwk": {
          "type": "object",
          "properties": {
            "kty": { "type": "string" },
            "crv": { "type": "string" },
            "x": { "$ref": "#/$defs/base64url" },
            "y": { "$ref": "#/$defs/base64url" }
          },
          "required": ["kty", "crv", "x"],
          "additionalProperties": true
        }
      },
      "required": ["jwk"],
      "additionalProperties": true
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217 alpha-3."
    },
    "base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "epochSeconds": { "type": "integer", "minimum": 0 }
  }
}
