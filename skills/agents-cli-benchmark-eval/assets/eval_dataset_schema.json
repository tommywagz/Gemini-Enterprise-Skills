{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Agent Evaluation Dataset",
  "type": "object",
  "required": ["version", "cases"],
  "properties": {
    "version": {"type": "string"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "prompt", "expected", "assertions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "prompt": {"type": "string"},
        "expected": {"type": "string"},
        "actual": {"type": "string"},
        "expected_route": {"type": "boolean"},
        "side_effect_risk": {"enum": ["none", "low", "high"]},
        "assertions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assertion"}}
      },
      "additionalProperties": true
    },
    "assertion": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["exact_match", "contains", "not_contains", "route", "min_token_overlap", "min_semantic_similarity_proxy"]},
        "value": {"type": ["string", "number", "boolean"]}
      },
      "additionalProperties": false
    }
  }
}
