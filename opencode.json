{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vertex": {
      "npm": "@ai-sdk/google-vertex",
      "name": "Google Vertex AI",
      "options": {
        "project": "gemini-api-505408",
        "location": "global"
      }
    }
  },
  "agents": {
    "orchestrator": {
      "model": "vertex/gemini-3.6-flash",
      "systemPromptFile": ".agents/orchestrator.md",
      "autoApprove": true,
      "worktree": false
    },
    "finder": {
      "model": "vertex/gemini-3.5-flash",
      "systemPromptFile": ".agents/finder.md",
      "autoApprove": true
    },
    "creator": {
      "model": "anthropic/claude-opus-5",
      "systemPromptFile": ".agents/creator.md",
      "autoApprove": true
    },
    "evaluator": {
      "model": "openai/o3",
      "systemPromptFile": ".agents/evaluator.md",
      "autoApprove": true
    }
  }
}
