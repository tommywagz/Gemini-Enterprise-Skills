{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "google-vertex": {
      "name": "Google Vertex AI",
      "options": {
        "project": "gemini-api-505408",
        "location": "global"
      },
      "models": {
        "gemini-3.8-flash": { "reasoning": false },
        "gemini-3.5-flash": { "reasoning": false }
      }
    }
  },
  "agents": {
    "orchestrator": {
      "model": "google-vertex/gemini-3.5-flash",
      "systemPromptFile": ".agents/orchestrator.md",
      "autoApprove": true,
      "worktree": false
    },
    "finder": {
      "model": "google-vertex/gemini-3.8-flash",
      "systemPromptFile": ".agents/finder.md",
      "autoApprove": true
    },
    "creator": {
      "model": "anthropic/claude-sonnet-5",
      "systemPromptFile": ".agents/creator.md",
      "autoApprove": true
    },
    "evaluator": {
      "model": "openai/5.6-terra",
      "systemPromptFile": ".agents/evaluator.md",
      "autoApprove": true
    }
  }
}
