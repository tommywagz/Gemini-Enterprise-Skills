{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/2026-09-18/food_ordering.json",
  "title": "UCP Food Ordering Vertical Extension Schema",
  "description": "Defines restaurant dining options, pickup/delivery scheduling, and item customizations extending UCP checkout.",
  "type": "object",
  "ucp": {
    "namespace": "com.example.food_ordering",
    "version": "2026-09-18",
    "extends": "dev.ucp.shopping.checkout"
  },
  "properties": {
    "food_ordering": {
      "type": "object",
      "required": ["service_type"],
      "properties": {
        "service_type": {
          "type": "string",
          "enum": ["pickup", "delivery", "curbside", "dine_in"],
          "description": "Method of meal fulfillment."
        },
        "asap": {
          "type": "boolean",
          "default": true,
          "description": "Whether the order should be prepared immediately."
        },
        "requested_time": {
          "type": "string",
          "format": "date-time",
          "description": "Target fulfillment ISO timestamp if scheduled in advance."
        },
        "table_number": {
          "type": "string",
          "description": "Table or seating identifier for dine-in orders."
        },
        "curbside_vehicle": {
          "type": "object",
          "properties": {
            "make": { "type": "string" },
            "color": { "type": "string" },
            "license_plate": { "type": "string" }
          },
          "additionalProperties": false
        },
        "dietary_alerts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Allergen or dietary advisories (e.g. peanut_allergy, celiac)."
        },
        "utensils_requested": {
          "type": "boolean",
          "default": false,
          "description": "Whether disposable cutlery and napkins should be included."
        },
        "contactless_delivery": {
          "type": "boolean",
          "default": false
        },
        "kitchen_notes": {
          "type": "string",
          "maxLength": 500,
          "description": "General preparation or packaging instructions for the kitchen."
        },
        "item_customizations": {
          "type": "array",
          "description": "Ingredient substitutions, add-ons, or special instructions per line item.",
          "items": {
            "$ref": "#/$defs/ItemCustomization"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "ItemCustomization": {
      "type": "object",
      "required": ["line_item_id"],
      "properties": {
        "line_item_id": {
          "type": "string",
          "description": "Reference to the line item in the checkout session."
        },
        "selected_options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["group_id", "choice_id"],
            "properties": {
              "group_id": { "type": "string" },
              "choice_id": { "type": "string" },
              "additional_amount": { "type": "integer", "minimum": 0, "default": 0 }
            },
            "additionalProperties": false
          }
        },
        "special_instructions": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    }
  }
}
